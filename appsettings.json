{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=InventoryDb;Username=postgres;Password=YOUR_PASSWORD"
    },

    "Jwt": {
        "Issuer": "InventoryApi",
        "Audience": "InventoryApi.Client",
        "SigningKey": "your-local-development-key-at-least-32-bytes-long"
    }
}
